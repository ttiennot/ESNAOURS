<%- include('partials/header') %>
<section class="hero">
  <div class="wrap hero-inner">
    <div class="hero-text">
      <img class="hero-crest" src="/static/img/crest-seniors.png" alt="Logo Seniors ES Naours" width="120" height="120">
      <span class="chip-badge"><i></i><%= settings.competition_label %></span>
      <h1><%= settings.club_name %></h1>
      <p><%= settings.hero_tagline %></p>
      <% if (us) { %>
      <div class="hero-stats">
        <div><b class="accent"><%= us.rank %><sup><%= us.rank === 1 ? 'er' : 'e' %></sup></b><span>Classement</span></div>
        <div><b><%= us.points %></b><span>Points</span></div>
        <div><b><%= us.won %>-<%= us.drawn %>-<%= us.lost %></b><span>V-N-D</span></div>
      </div>
      <% } %>
    </div>

    <div class="next-card">
      <% if (next) { %>
        <div class="nc-head"><span>Prochain match</span><% if (next.round) { %><span class="nc-round"><%= next.round %></span><% } %></div>
        <div class="nc-teams">
          <% [['home', !!next.is_home], ['away', !next.is_home]].forEach(([side, isUs]) => { const name = next[side + '_team']; const r = rankOf[name]; %>
            <div class="nc-team">
              <%- h.badge(name, next[side + '_logo'], { us: isUs, settings, size: 'lg' }) %>
              <strong><%= name %></strong>
              <span><%= side === 'home' ? 'Domicile' : 'Extérieur' %><%= r ? ' · ' + r + (r === 1 ? 'er' : 'e') : '' %></span>
            </div>
            <% if (side === 'home') { %><span class="nc-vs">VS</span><% } %>
          <% }) %>
        </div>
        <div class="nc-when">
          <strong><%= h.fmtDate(next.date, { long: true }) %><%= next.time ? ' · ' + next.time.replace(':', 'h') : '' %></strong>
          <% if (next.venue) { %><span class="nc-venue"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"></path><circle cx="12" cy="9.5" r="2.5"></circle></svg><%= next.venue %></span><% } %>
          <% if (next.status) { %><span class="tag tag--warn"><%= next.status %></span><% } %>
        </div>
        <% if (next.date && next.time) { %><div class="countdown" role="timer" aria-label="Compte à rebours avant le coup d'envoi" data-kickoff="<%= next.date %>T<%= next.time %>:00"></div><% } %>
        <div class="nc-actions">
          <a class="btn btn--accent" href="/match/<%= next.id %><%= nextLineup ? '#compo' : '' %>"><%= nextLineup ? 'Voir la compo' : 'Détails du match' %></a>
          <% if (next.venue) { %><a class="btn btn--glass" href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(next.venue) %>" target="_blank" rel="noopener">Itinéraire</a><% } %>
        </div>
      <% } else { %>
        <div class="nc-head"><span>Prochain match</span></div>
        <p class="nc-empty">Aucun match programmé pour le moment.<br>Le calendrier sera mis à jour dès sa publication par le District.</p>
      <% } %>
    </div>
  </div>
</section>
<%- include('partials/masthead-end') %>

<div class="wrap home-grid">
  <section class="card" aria-labelledby="h-results">
    <div class="card-head"><h2 id="h-results">Derniers résultats</h2><a href="/calendrier">Calendrier complet →</a></div>
    <% if (results.length) { %>
      <div class="match-list"><% results.forEach(m => { %><%- include('partials/match-row', { m }) %><% }) %></div>
    <% } else { %><p class="empty">Pas encore de résultat cette saison.</p><% } %>
    <% if (upcoming.length) { %>
      <h3 class="sub">À venir</h3>
      <div class="match-list"><% upcoming.forEach(m => { %><%- include('partials/match-row', { m }) %><% }) %></div>
    <% } %>
  </section>

  <section class="card" aria-labelledby="h-table">
    <div class="card-head"><h2 id="h-table">Classement</h2><a href="/classement">Voir tout →</a></div>
    <% if (excerpt.length) { %>
      <%- include('partials/standings', { rows: excerpt, full: false }) %>
      <% if (gap) { %>
        <div class="gap-box">
          <div><span><%= gap.label %></span><strong><%= gap.pts %> point<%= Math.abs(gap.pts) > 1 ? 's' : '' %></strong></div>
          <% if (form.length) { %><div class="form-squares" aria-label="Forme récente : <%= form.join(', ') %>"><% form.forEach(o => { %><i class="fs fs--<%= o %>" title="<%= { V: 'Victoire', N: 'Nul', D: 'Défaite' }[o] %>"></i><% }) %></div><% } %>
        </div>
      <% } %>
    <% } else { %><p class="empty">Classement bientôt disponible.</p><% } %>
  </section>

  <section class="card card--wide" aria-labelledby="h-news">
    <div class="card-head"><h2 id="h-news">Actualités du club</h2><a href="/club">Toutes les infos →</a></div>
    <% if (posts.length) { %>
      <div class="posts">
        <% posts.forEach(p => { %>
          <a class="post-card" href="/actus/<%= p.id %>">
            <% if (p.image) { %><img src="<%= p.image %>" alt="" loading="lazy"><% } else { %><div class="post-ph"><img src="/static/img/crest.png" alt=""></div><% } %>
            <span class="chip"><%= p.pinned ? 'À la une' : 'Vie du club' %></span>
            <h3><%= p.title %></h3>
            <span class="post-date"><%= h.fmtPosted(p.created_at) %></span>
          </a>
        <% }) %>
      </div>
    <% } else { %><p class="empty">Aucune actualité pour l'instant.</p><% } %>
  </section>

  <% if (albums.length) { %>
  <section class="card card--wide" aria-labelledby="h-photos">
    <div class="card-head"><h2 id="h-photos">Dernières photos</h2><a href="/photos">Photothèque →</a></div>
    <div class="album-grid album-grid--small"><% albums.forEach(a => { %><%- include('partials/album-card', { a }) %><% }) %></div>
  </section>
  <% } %>
</div>
<%- include('partials/footer') %>
