<%- include('_top') %>
<div class="admin-head"><h1>Actualités</h1><a class="btn" href="/admin/actus/new">+ Nouvelle actualité</a></div>
<% if (!posts.length) { %><p class="panel muted">Aucune actualité.</p><% } else { %>
<div class="panel table-wrap"><table class="admin-table">
  <thead><tr><th>Titre</th><th>Date</th><th>Statut</th><th></th></tr></thead>
  <tbody><% posts.forEach(p => { %>
    <tr><td><a href="/admin/actus/<%= p.id %>"><strong><%= p.title %></strong></a><%= p.pinned ? ' 📌' : '' %></td><td><%= h.fmtPosted(p.created_at) %></td>
    <td><%= p.published ? 'Publiée' : 'Brouillon' %></td><td class="actions"><a href="/admin/actus/<%= p.id %>">Modifier</a> · <a href="/actus/<%= p.id %>" target="_blank">Voir</a></td></tr>
  <% }) %></tbody>
</table></div>
<% } %>
<%- include('_bottom') %>
