<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title ? title + ' · ' : '' %><%= settings.club_name %> – <%= settings.team_label %></title>
<meta name="description" content="<%= settings.club_name %> : calendrier, résultats, classement, effectif et photos de l'équipe <%= settings.team_label %>.">
<meta name="theme-color" content="#062419">
<link rel="icon" href="<%= settings.logo || '/static/img/crest-180.png' %>">
<link rel="apple-touch-icon" href="/static/img/crest-180.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/static/css/style.css?v=3">
</head>
<body>
<a class="skip" href="#main">Aller au contenu</a>
<div class="masthead">
  <div class="masthead-motif" aria-hidden="true">
    <svg class="motif-pitch" viewBox="0 0 1050 680" fill="none" stroke="currentColor" stroke-width="2">
      <rect x="5" y="5" width="1040" height="670" rx="2"></rect>
      <line x1="525" y1="5" x2="525" y2="675"></line>
      <circle cx="525" cy="340" r="91.5"></circle>
      <circle cx="525" cy="340" r="3" fill="currentColor"></circle>
      <rect x="5" y="138.5" width="165" height="403"></rect>
      <rect x="5" y="248.5" width="55" height="183"></rect>
      <path d="M170 266.9 A91.5 91.5 0 0 1 170 413.1"></path>
      <rect x="880" y="138.5" width="165" height="403"></rect>
      <rect x="990" y="248.5" width="55" height="183"></rect>
      <path d="M880 266.9 A91.5 91.5 0 0 0 880 413.1"></path>
    </svg>
    <span class="motif-ring"></span>
  </div>
  <header class="site-header">
    <div class="wrap header-inner">
      <a class="brand" href="/">
        <img src="<%= settings.logo || '/static/img/crest.png' %>" alt="" class="brand-crest">
        <span class="brand-text"><strong><%= settings.club_name %></strong><small><%= settings.team_label %></small></span>
      </a>
      <button class="nav-toggle" aria-expanded="false" aria-controls="nav" aria-label="Menu"><span></span><span></span><span></span></button>
      <nav id="nav" class="nav" aria-label="Navigation principale">
        <% const links = [['/', 'Accueil'], ['/calendrier', 'Calendrier'], ['/classement', 'Classement'], ['/effectif', 'Effectif'], ['/compo', 'Compo'], ['/photos', 'Photos'], ['/club', 'Le club']]; %>
        <% for (const [href, label] of links) { const active = href === '/' ? path === '/' : path.startsWith(href) || (href === '/compo' && path.startsWith('/match')) || (href === '/club' && path.startsWith('/actus')); %>
          <a href="<%= href %>"<%- active ? ' class="active" aria-current="page"' : '' %>><%= label %></a>
        <% } %>
        <% if (isAdmin) { %><a href="/admin" class="nav-admin">Admin</a><% } %>
      </nav>
    </div>
  </header>
