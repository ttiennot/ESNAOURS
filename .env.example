# Copier ce fichier en .env puis remplir les valeurs.

# Mot de passe admin initial (utilisé au premier démarrage seulement).
ADMIN_PASSWORD=change-moi-tout-de-suite

# Clé secrète des sessions : une longue chaîne aléatoire.
# Générer avec :  openssl rand -hex 32
SESSION_SECRET=

# Fréquence de synchronisation FFF (minutes)
SYNC_INTERVAL_MINUTES=30

# Mettre à 1 pour forcer ADMIN_PASSWORD au prochain démarrage (mot de passe oublié),
# puis remettre à 0.
ADMIN_PASSWORD_RESET=0
